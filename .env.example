# 复制本文件为 .env，填入真实 Key；.env 已被 gitignore，不会提交
# 文本模型 / 复盘 / 分类 / 解题
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_MODEL=deepseek-flash

# 图片识别（可与上面同一个 Key；不填则复用 DEEPSEEK_API_KEY）
VISION_API_KEY=sk-你的key
VISION_MODEL=deepseek-flash

# 可选：识别输出上限（默认 6000）
# VISION_MAX_TOKENS=6000

# 可选：单次解题/复盘输出上限（默认 8000 tokens）
# MAX_ANSWER_TOKENS=8000

# 可选：方法库注入上限（默认 14000 字）
# SKILL_MAX_CHARS=14000
